# Publication safety: local identities, generated portraits, editorial state,
# and one-off production scripts are not part of the public source release.
/assets/avatar/**
!/assets/avatar/README.md
/canon/*.json
!/canon/graph_schema.json
!/canon/rights-manifest.json
!/canon/safety-reviews.json
!/canon/*_policy.json
!/canon/example*.json
/docs/**
!/docs/OPEN_SOURCE_READINESS.md
!/docs/SAFETY_MODEL.md
!/docs/ARCHITECTURE.md
!/docs/RELEASE_CHECKLIST.md
!/docs/COLLECTION.md
!/docs/COLLECTION_LIVE_CHECK.md
!/docs/HISTORICAL_SOURCES.md
!/docs/historical_sources.json
!/docs/stem_seeds.json
/examples/**
!/examples/synthetic_corpus.json
!/examples/synthetic_demo.py
/scripts/**
!/scripts/open_source_audit.py
!/scripts/validate_rights.py
!/scripts/git_history_audit.py
!/scripts/build_sbom.py
!/scripts/build_checksums.py
!/scripts/audit_archive.py
!/scripts/restore_avatar_models.py
!/scripts/media_integrity.py
!/scripts/live_collection_smoke.py
/tests/**
!/tests/test_open_source_audit.py
!/tests/test_scene_backend.py
!/tests/test_voice_consent.py
!/tests/test_i18n.py
!/tests/test_airgap.py
!/tests/test_authorizations.py
!/tests/test_archive_audit.py
!/tests/test_backend_identity.py
!/tests/test_graph.py
!/tests/test_local_api_security.py
!/tests/test_retrieval.py
!/tests/test_release_evidence.py
!/tests/test_rights_audit.py
!/tests/test_safety.py
!/tests/test_synthetic_demo.py
!/tests/test_safe_index.py
!/tests/test_voice.py
!/tests/test_sources.py
!/tests/test_collect.py

# Platform receipts and local browser/account evidence must never be committed.
**/publish_receipt.json
**/publication_state.json
**/*cookie*
**/*receipt*
**/*browser-profile*/

